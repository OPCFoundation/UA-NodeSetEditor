<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS / Azure App Service configuration overrides.

  The OPC UA NodeSet Editor encodes NodeIds in URL paths, which routinely
  contain "%2F" (encoded forward slash) inside the encoded value. By default
  IIS rejects requests with double-escaped paths as a security measure, which
  here causes the route to never match — the request falls through to the SPA
  fallback and the client receives index.html instead of the API JSON.
  Setting allowDoubleEscaping="true" lets these requests reach ASP.NET Core's
  routing layer.

  ASP.NET Core's publish target appends the <aspNetCore> handler block
  automatically; only the security settings need to be specified here.
-->
<configuration>
  <system.webServer>
  </system.webServer>
</configuration>
